@if (IsVisible)
{
    <div class="skeleton-toast @(IsExiting ? "skeleton-toast-exit" : "")">
        <div class="skeleton-toast-icon">
            <i class="fa-solid fa-circle-notch fa-spin"></i>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool IsExiting { get; set; }

    public bool IsVisible => IsLoading || IsExiting;
}