{
  "ReleaseVersion": "1.0.0",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "Properties": {
      "Application": "Void.Bot.Api"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "ServerUrl": "http://localhost:5341",
          "ApiKey": ""
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mysql": "server=localhost;userid=root;password=123456;database=db_void_bot;Allow User Variables=True;",
    "Redis": "localhost:6379,password=,ssl=False,abortConnect=False,syncTimeout=50000,allowAdmin=true"
  },
  "Cache": {
    "UseStorage": "Redis",
    "RedisDatabaseIndex": 0
  },
  "Hangfire": {
    "EnableDashboard": true,
    "DashboardPath": "/hangfire",
    "DashboardUser": "admin",
    "DashboardPassword": "hangfire"
  },
  "Jwt": {
    "Secret": "PLEASE_ENTER_32_CHAR_SECRET_KEY_",
    "Issuer": "VoidBot",
    "Audience": "VoidBotClient",
    "ExpireMinutes": 60,
    "RefreshExpireDays": 7
  },
  "SecretKey": "PLEASE_ENTER_32_CHAR_SECRET_KEY_",
  "SecretProtection": {
    "EncryptionKey": ""
  },
  "Email": {
    "ClientId": "",
    "ClientSecret": "",
    "Tenant": "consumers",
    "RedirectUri": "https://localhost:3669/api/email/oauth/callback",
    "ExpectedSenderEmail": "",
    "StateTtlSeconds": 600,
    "TokenRefreshIntervalDays": 30
  },
  "AccountEmail": {
    "CodeTtlMinutes": 10,
    "ResendIntervalSeconds": 60,
    "MaxSendsPerHour": 5,
    "MaxAttempts": 5,
    "PasswordResetLinkTtlMinutes": 15,
    "PasswordResetFrontendUrl": "https://voidbot.cyooops.icu/password-reset"
  },
  "Scalar": {
    "Enable": true,
    "ForceHttps": true
  },
  "DomainUrl": "https://127.0.0.1:3669",
  "ProxyUrl": "http://localhost:7890",
  "Discord": {
    "EnableProxy": false,
    "AutoStart": false,
    "Token": "",
    "ClientId": "PLEASE_SET_DISCORD_CLIENT_ID",
    "ClientSecret": "PLEASE_SET_DISCORD_CLIENT_SECRET"
  },
  "OAuth": {
    "StateTtlSeconds": 600,
    "ExchangeTtlSeconds": 120,
    "RegistrationTtlSeconds": 600,
    "FrontendCallbackUrl": "https://voidbot.cyooops.icu/oauth/callback"
  },
  "Steam": {
    "ApiKey": ""
  },
  "Bungie": {
    "ClientId": "",
    "ClientSecret": "",
    "ApiKey": ""
  },
  "Destiny2": {
    "SyncLanguages": [ "en", "zh-cht", "zh-chs" ],
    "SyncManifests": [ "Season", "Activity", "ActivityMode", "Metric", "InventoryItem", "PlugSet", "Stat", "Trait", "BreakerType", "SandboxPerk" ],
    "Cache": {
      "PlayerDataMinutes": 5,
      "RaidDungeonStatsMinutes": 5
    },
    "RaidDungeon": {
      "PlayerStartThresholdSeconds": 60
    }
  },
  "Language": {
    "GenerateDefaultYamlFile": true,
    "OverwriteDefaultYamlFile": false
  }
}
