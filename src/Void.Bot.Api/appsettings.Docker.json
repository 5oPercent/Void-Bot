{
  "ReleaseVersion": "1.0.0",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "Properties": {
      "Application": "Void.Bot.Api"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "ServerUrl": "http://host.docker.internal:5341",
          "ApiKey": ""
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mysql": "server=host.docker.internal;userid=root;password=123456;database=db_void_bot;Allow User Variables=True;",
    "Redis": "host.docker.internal:6379,password=,ssl=False,abortConnect=False,syncTimeout=50000,allowAdmin=true"
  },
  "Hangfire": {
    "EnableDashboard": true,
    "UseStorage": 0
  },
  "DomainUrl": "https://127.0.0.1:3399",
  "ProxyUrl": "http://host.docker.internal:7890",
  "Discord": {
    "EnableProxy": false,
    "AutoStart": false,
    "Token": ""
  },
  "Steam": {
    "ApiKey": ""
  },
  "Bungie": {
    "ClientId": "",
    "ClientSecret": "",
    "ApiKey": ""
  }
}