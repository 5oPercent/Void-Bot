{
  "ReleaseVersion": "1.0.0",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "Properties": {
      "Application": "Void.Bot.Api"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "ServerUrl": "http://host.docker.internal:5341",
          "ApiKey": ""
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mysql": "server=host.docker.internal;userid=root;password=123456;database=db_void_bot;Allow User Variables=True;",
    "Redis": "host.docker.internal:6379,password=,ssl=False,abortConnect=False,syncTimeout=50000,allowAdmin=true"
  },
  "Cache": {
    "UseStorage": "Redis",
    "RedisDatabaseIndex": 0
  },
  "Hangfire": {
    "EnableDashboard": true,
    "DashboardPath": "/hangfire",
    "DashboardUser": "admin",
    "DashboardPassword": "hangfire"
  },
  "Jwt": {
    "Secret": "PLEASE_ENTER_32_CHAR_SECRET_KEY_",
    "Issuer": "VoidBot",
    "Audience": "VoidBotClient",
    "ExpireMinutes": 60
  },
  "SecretKey": "PLEASE_ENTER_32_CHAR_SECRET_KEY_",
  "Scalar": {
    "Enable": true,
    "ForceHttps": true
  },
  "DomainUrl": "https://127.0.0.1:3399",
  "ProxyUrl": "http://host.docker.internal:7890",
  "Discord": {
    "EnableProxy": false,
    "AutoStart": false,
    "Token": ""
  },
  "OAuth": {
    "StateTtlSeconds": 600,
    "Discord": {
      "ClientId": "PLEASE_SET_DISCORD_CLIENT_ID",
      "ClientSecret": "PLEASE_SET_DISCORD_CLIENT_SECRET"
    }
  },
  "Steam": {
    "ApiKey": ""
  },
  "Bungie": {
    "ClientId": "",
    "ClientSecret": "",
    "ApiKey": ""
  },
  "Destiny2": {
    "SyncLanguages": [ "en", "zh-cht", "zh-chs" ],
    "SyncManifests": [ "Season" ]
  }
}
